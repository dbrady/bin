#!/bin/bash
# sum-values - pipe numbers in and add them up
#
# Usage:
#
# Assuming you have numbers, one per line
# $ echo -e "5.1\n6.3\n3.5" > floats.txt
# $ echo -e "5\n6\n3" > ints.txt
#
# $ cat floats.txt | sum-values
# 14.9
#
# $ cat ints.txt | sum-values
# 14

paste -sd+ - | bc

