#!/bin/bash
# gfm [-t|--toc] [-w|--wide] [-n|--no-open] [-o FILE] <file.md> - style document with github-flavored markdown and open it in browser
#
#   -t, --toc      add a table of contents built from the document's headers
#   -w, --wide     drop the 46rem column and use a flat 100px gutter instead
#   -n, --no-open  write the HTML but do not open it in the browser
#   -o FILE        write the HTML to FILE instead of /tmp/<basename>.html

TOC=
WIDE=
OPEN=1
HTML_PATH=

while [ $# -gt 0 ]; do
  case "$1" in
    -t|--toc)     TOC=1; shift ;;
    -w|--wide)    WIDE=1; shift ;;
    -n|--no-open) OPEN=; shift ;;
    -o|--output)  HTML_PATH="$2"; shift 2 ;;
    -h|--help)    sed -n '2,7p' "$0" | cut -c3-; exit 0 ;;
    *) break ;;
  esac
done

if [ -z "$1" ]; then
  sed -n '2,7p' "$0" | cut -c3-
  exit 1
fi

[ -z "$HTML_PATH" ] && HTML_PATH=/tmp/$(basename "$1" .md).html

echo "GFM_TOC=$TOC GFM_WIDE=$WIDE kramdown --input GFM --template \$HOME/bin/lib/gfm-template.html $1 > $HTML_PATH"
GFM_TOC=$TOC GFM_WIDE=$WIDE kramdown --input GFM --template "$HOME/bin/lib/gfm-template.html" "$1" > "$HTML_PATH" || exit $?

[ -z "$OPEN" ] && exit 0

echo open "$HTML_PATH"
open "$HTML_PATH"
