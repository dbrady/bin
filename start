#!/usr/bin/env ruby
# start - exec a bash command recorded for the current folder or repo.

require 'colorize'
require 'fileutils'
require 'optimist'
require 'shellwords'
require 'yaml'
$LOAD_PATH.unshift(File.expand_path('~/bin/lib'))
require 'dbrady_cli'
String.disable_colorization unless $stdout.tty?

# CLI Application
class Application
  include DbradyCli

  SELECTA = File.expand_path('~/bin/selecta')
  CONFIG = File.expand_path('~/.config/start/start.yml')

  # 'default' lives in the same hash as the command names, so an entry called
  # "default" would be unreachable and would break bare `start` for its block.
  # 'new', 'edit' and 'list' would be parsed as subcommands, never looked up.
  RESERVED = %w[default new edit list].freeze

  def parse_options
    @opts = Optimist.options do
      banner <<~BANNER
        start - exec a bash command recorded for the current folder or repo

        start                     - run the default command recorded here
        start <name> [args...]    - run the command recorded as <name>
        start -i                  - pick from the commands recorded here
        start list                - show the commands recorded here
        start new <name> '<cmd>'  - record a command here without opening the config
        start default <name>      - make <name> the one bare `start` runs
        start default             - clear the default
        start edit                - open the config in $EDITOR

        Commands live in ~/.config/start/start.yml. A top-level key is a folder
        path or a repo's remote URL. Folder entries match when start runs in
        that exact folder; remote entries match from anywhere inside any clone
        of that repo. Under each key, names map to bash commands:

          github.com/acima-credit/kipper:
            default: server
            server: bin/rails s -p 3002
            anycable: anycable-go --port=3334

          /Users/dbrady/scratch/blog:
            hugo: hugo serve

        Bare `start` runs the entry named by `default:`. With no default and
        exactly one entry, it runs that; with several, it shows the list to
        pick from. If a folder entry and a repo entry share a name, the
        folder's wins.

        Anything after the name is handed to the command as $1..$n. Put "$@"
        in the recorded command where you want those args to appear:

          server: bin/rails s -p 3002 "$@"
          $ start server --binding=0.0.0.0   # bin/rails s -p 3002 --binding=0.0.0.0

        Options, before the command name:
      BANNER
      opt :interactive, 'Choose the command from a list', short: :i, default: false
      opt :debug, 'Print extra debug info', short: :d, default: false
      opt :pretend, 'Print commands but do not run them', short: :p, default: false
      opt :quiet, 'Run with minimal output', short: :q, default: false
      opt :verbose, 'Run with verbose output (overrides --quiet)', short: :v, default: false

      # stop_on_unknown, not stop_on SUBCOMMANDS: stop_on only stops at listed
      # words, so parsing `start server --binding=x` would die on the unknown
      # flag --binding. stop_on_unknown stops at `server`.
      stop_on_unknown
    end
    opts[:quiet] = !opts[:verbose] if opts[:verbose_given]
    dump_opts if debug?
    @command = ARGV.shift
  end

  def run
    parse_options
    case @command
    when 'new'     then run_new
    when 'edit'    then run_edit
    when 'list'    then run_list
    when 'default' then run_default
    else run_start(@command)
    end
  end

  private

  def folder_key
    @folder_key ||= Dir.pwd
  end

  # git finds the enclosing repo on its own, so `remote get-url` works from any
  # subdirectory. Normalizing makes ssh and https remotes produce the same key.
  def repo_key
    return @repo_key if defined?(@repo_key)

    url = `git remote get-url origin 2>/dev/null`.strip
    @repo_key =
      if url.empty?
        nil
      else
        url.sub(%r{\A\w+://}, '').sub(/\A[^\/@]+@/, '')
           .sub(%r{:\d+(?=/)}, '').sub(%r{:(?=[^/])}, '/')
           .sub(/\.git\z/, '').downcase
      end
  end

  def config_data
    return {} unless File.exist?(CONFIG)

    YAML.safe_load(File.read(CONFIG)) || {}
  rescue Psych::SyntaxError => e
    abort "start: #{CONFIG} is not valid YAML at line #{e.line}: #{e.problem}\n" \
          '       fix it with: start edit'
  end

  # Folder beats repo, key by key -- including 'default', so a folder can
  # change which command is the default while inheriting the command itself.
  def entries
    @entries ||= (config_data[repo_key] || {}).merge(config_data[folder_key] || {})
  end

  def commands
    entries.reject { |name, _| name == 'default' }
  end

  def run_start(name)
    abort no_commands_message if commands.empty?

    name ||= pick if opts[:interactive]
    name ||= entries['default'] || (commands.keys.first if commands.size == 1) || pick
    abort 'start: nothing selected' if name.nil?

    command = commands[name]
    abort "start: no command #{name.inspect} here. Known: #{commands.keys.join(', ')}" if command.nil?

    warn_about_dropped_args(name, command)
    launch(command, *ARGV)
  end

  # bash -c, not exec(command, *args): given more than one argument Ruby execs
  # directly instead of through a shell, turning any ; or && in the command
  # into literal arguments. bash -c CMD NAME ARGS sets $1..$n to ARGS, and
  # "$@" in the recorded command expands to them.
  def launch(command, *args)
    puts command.cyan if pretend? || !quiet?
    exec('bash', '-c', command, 'start', *args) unless pretend?
  end

  # Warn rather than abort -- dropped args should be visible, not fatal.
  def warn_about_dropped_args(name, command)
    return if ARGV.empty? || command.match?(/\$[@*1-9]/)

    warn %(start: ignoring #{ARGV.join(' ')} -- add "$@" to the #{name.inspect} command to accept args)
  end

  def no_commands_message
    <<~MSG.rstrip
      start: no commands recorded here. Looked under:
        folder: #{folder_key}
        repo:   #{repo_key || 'no git remote'}
      Record one with: start new <name> '<command>'
    MSG
  end

  # selecta draws on /dev/tty, leaving stdin to carry the list in and stdout
  # the choice out.
  def pick
    width = commands.keys.map(&:length).max
    by_line = commands.to_h { |name, command| [format("%-#{width}s  %s", name, command), name] }
    choice = IO.popen(SELECTA, 'r+') do |io|
      io.puts by_line.keys
      io.close_write
      io.read
    end
    $?&.success? ? by_line[choice.to_s.chomp] : nil
  end

  # Alphabetical: the config's own order is whatever `start new` happened to
  # leave behind.
  def run_list
    Optimist.die "start list takes no arguments -- got #{ARGV.join(' ')}" unless ARGV.empty?
    abort no_commands_message if commands.empty?

    default = entries['default']
    if default && !commands.key?(default)
      warn "start: the default here is #{default.inspect}, which is not recorded. Repoint it with: start default <name>"
      default = nil
    end

    width = commands.keys.map(&:length).max
    commands.keys.sort.each do |name|
      puts format("%s %-#{width}s  %s", name == default ? '*' : ' ', name, commands[name])
    end
  end

  def run_default
    sub = Optimist.options do
      banner <<~BANNER
        start default - name the command that bare `start` runs

        start default [--repo|--folder] <name>  - make <name> the default
        start default [--repo|--folder]         - clear the default

        At a repo root the default is recorded under the repo's remote URL;
        anywhere else, under the current folder. --repo and --folder force
        one or the other. A folder's default beats the repo's, so one clone
        can bare-start something different from every other clone.

        See what is recorded with: start list

        Options:
      BANNER
      opt :repo, "Record under the repo's remote URL, shared by every clone", default: false
      opt :folder, 'Record under the current folder path', default: false
      conflicts :repo, :folder
    end

    name, *rest = ARGV
    Optimist.die "give one name, or none to clear -- got #{rest.length + 1}" unless rest.empty?
    if name && !commands.key?(name)
      abort no_commands_message if commands.empty?
      abort "start: no command #{name.inspect} here. Known: #{commands.keys.sort.join(', ')}"
    end

    write_default(new_scope(sub), name)
  end

  def run_edit
    unless pretend?
      FileUtils.mkdir_p(File.dirname(CONFIG))
      File.write(CONFIG, '') unless File.exist?(CONFIG)
    end
    editor = ENV['EDITOR'].to_s.empty? ? 'vi' : ENV['EDITOR']
    launch("#{editor} #{CONFIG.shellescape}")
  end

  def run_new
    sub = Optimist.options do
      banner <<~BANNER
        start new - record a command in the config

        start new [--repo|--folder] [--default] <name> '<command>'

        Quote the command as one argument. Write "$@" in it wherever args from
        `start <name> ...` should go.

        At a repo root the entry is recorded under the repo's remote URL;
        anywhere else, under the current folder. --repo and --folder force
        one or the other.

        Options:
      BANNER
      opt :repo, "Record under the repo's remote URL, shared by every clone", default: false
      opt :folder, 'Record under the current folder path', default: false
      opt :default, 'Also record it as the default: entry', default: false
      conflicts :repo, :folder
    end

    name, *rest = ARGV
    Optimist.die 'give a name and a command' if name.nil? || rest.empty?
    Optimist.die "quote the command as one argument -- got #{rest.length}" if rest.length > 1
    Optimist.die "#{name.inspect} is reserved" if RESERVED.include?(name)

    write_entry(new_scope(sub), name, rest.first, sub[:default])
  end

  def new_scope(sub)
    return folder_key if sub[:folder]
    return repo_key || abort('start: --repo needs a git remote here; use --folder or add a remote') if sub[:repo]

    Dir.exist?('.git') ? (repo_key || folder_key) : folder_key
  end

  # Insert lines; never YAML.load/dump round-trip -- Psych would delete the
  # user's comments.
  def write_entry(scope, name, command, make_default)
    lines = config_lines
    header = header_index(lines, scope)

    if header
      drop_defaults(lines, header) if make_default
      lines[header] = "#{lines[header].chomp}\n"
      lines.insert(header + 1, entry(name, command))
      lines.insert(header + 1, "  default: #{name}\n") if make_default
    else
      lines << "\n" unless lines.empty? || lines.last.end_with?("\n")
      lines << "#{scope}:\n"
      lines << "  default: #{name}\n" if make_default
      lines << entry(name, command)
    end

    save(lines, "recorded #{name} under #{scope}")
  end

  def write_default(scope, name)
    lines = config_lines
    header = header_index(lines, scope)
    dropped = header ? drop_defaults(lines, header) : 0

    if name.nil?
      abort nothing_to_clear_message(scope) if dropped.zero?

      return save(lines, "cleared the default under #{scope}")
    end

    if header
      lines[header] = "#{lines[header].chomp}\n"
      lines.insert(header + 1, "  default: #{name}\n")
    else
      lines << "\n" unless lines.empty? || lines.last.end_with?("\n")
      lines << "#{scope}:\n"
      lines << "  default: #{name}\n"
    end

    save(lines, "recorded #{name} as the default under #{scope}")
  end

  # The scope written to is not always the scope the default came from: in a
  # repo subfolder the write goes to the folder while the default is the repo's.
  def nothing_to_clear_message(scope)
    holder = [folder_key, repo_key].compact.find { |key| key != scope && config_data[key]&.key?('default') }
    return "start: no default recorded under #{scope}\n       see what is recorded with: start list" if holder.nil?

    <<~MSG.rstrip
      start: no default recorded under #{scope}
             the default here comes from #{holder}
             clear that one with: start default #{holder == repo_key ? '--repo' : '--folder'}
    MSG
  end

  def config_lines
    File.exist?(CONFIG) ? File.readlines(CONFIG) : []
  end

  # rindex, not index: YAML gives a later duplicate key the win, so the last
  # block is the one being read back.
  def header_index(lines, scope)
    lines.rindex { |line| line.chomp =~ /\A#{Regexp.escape(scope)}:\s*(#.*)?\z/ }
  end

  # YAML gives a later duplicate key the win, so an existing default: left in
  # place would outrank the one being inserted above it.
  def drop_defaults(lines, header)
    indent = block_indent(lines, header)
    return 0 if indent.nil?

    hits = ((header + 1)...lines.length).select do |i|
      block?(lines, header, i) && lines[i].start_with?("#{indent}default:")
    end
    hits.reverse_each { |i| lines.delete_at(i) }
    hits.length
  end

  # Anchoring to the indentation the block's keys share keeps drop_defaults out
  # of block scalars, whose text is indented deeper and may say anything.
  def block_indent(lines, header)
    found = ((header + 1)...lines.length).find { |i| block?(lines, header, i) && !lines[i].strip.empty? }
    found && lines[found][/\A[ \t]+/]
  end

  # True if lines[index] is still inside the block that starts at lines[header].
  def block?(lines, header, index)
    ((header + 1)..index).all? { |i| lines[i].strip.empty? || lines[i].start_with?(' ', "\t") }
  end

  def save(lines, message)
    if pretend?
      puts lines.join
    else
      FileUtils.mkdir_p(File.dirname(CONFIG))
      File.write(CONFIG, lines.join)
      puts message.green unless quiet?
    end
  end

  # Always double-quote: commands routinely contain #, :, and single quotes,
  # which all break unquoted YAML values.
  def entry(name, command)
    %(  #{name}: "#{command.gsub(/[\\"]/) { |c| "\\#{c}" }}"\n)
  end
end

Application.new.run if __FILE__ == $PROGRAM_NAME
