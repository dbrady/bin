#!/usr/bin/env ruby
# frozen_string_literal: true

# start - launch a recorded service (usually the dev server) for this project.
# Services live in ~/.config/start/start.yml (override: START_CONFIG), keyed by
# normalized git remote (all checkouts of a repo) or by absolute folder path
# (this folder only). Folder entries override repo entries key by key.

require 'colorize'
require 'fileutils'
require 'optimist'
require 'shellwords'
require 'yaml'
$LOAD_PATH.unshift(File.expand_path('~/bin/lib'))
require 'dbrady_cli'
String.disable_colorization unless $stdout.tty?

# CLI Application
class Application
  include DbradyCli

  SELECTA = File.expand_path('~/bin/selecta')
  DEFAULT_CONFIG = File.expand_path('~/.config/start/start.yml')

  # 'default' lives in the same hash as the service names, so a service called
  # "default" would be unreachable and would break bare `start` for the scope.
  # 'new' and 'edit' are eaten by subcommand dispatch before they can resolve.
  RESERVED = %w[default new edit].freeze

  def parse_options
    @opts = Optimist.options do
      banner <<~BANNER
        start - launch a service for this project

        Usage:
          start [options] [<service>] [args...]
          start [options] new [--repo|--folder] [--default] <service> '<command>'
          start [options] edit

        Extra args reach the program only where the command says "$@":
          server: bin/rails server -p 3000 "$@"

        With no service named: runs the default, or the only service if there is
        just one, otherwise opens the picker.

        Options (must come BEFORE the service name):
      BANNER
      opt :interactive, 'Pick the service interactively', short: :i, default: false
      opt :debug, 'Print extra debug info', short: :d, default: false
      opt :pretend, 'Print commands but do not run them', short: :p, default: false
      opt :quiet, 'Run with minimal output', short: :q, default: false
      opt :verbose, 'Run with verbose output (overrides --quiet)', short: :v, default: false

      # stop_on_unknown, not stop_on SUBCOMMANDS: stop_on would let
      # `start server --binding=x` feed --binding to this parser and abort.
      stop_on_unknown
    end
    opts[:quiet] = !opts[:verbose] if opts[:verbose_given]
    dump_opts if debug?
    @command = ARGV.shift
  end

  def run
    parse_options
    case @command
    when 'new'  then run_new
    when 'edit' then run_edit
    else run_start(@command)
    end
  end

  private

  def config_path
    @config_path ||= ENV.fetch('START_CONFIG', DEFAULT_CONFIG)
  end

  def folder_key
    @folder_key ||= Dir.pwd
  end

  # git already walks up to the repo, so `remote get-url` is the whole lookup.
  # Normalizing every URL spelling onto one key lets all checkouts share an entry.
  def repo_key
    return @repo_key if defined?(@repo_key)

    url = `git remote get-url origin 2>/dev/null`.strip
    @repo_key =
      if url.empty?
        nil
      else
        url.sub(%r{\A\w+://}, '').sub(/\A[^\/@]+@/, '')
           .sub(%r{:\d+(?=/)}, '').sub(%r{:(?=[^/])}, '/')
           .sub(/\.git\z/, '').downcase
      end
  end

  def config_data
    return {} unless File.exist?(config_path)

    YAML.safe_load(File.read(config_path)) || {}
  rescue Psych::SyntaxError => e
    abort "start: #{config_path} is not valid YAML (line #{e.line}): #{e.problem}\n" \
          '       fix it with: start edit'
  end

  # Folder beats repo, key by key -- including 'default', so a folder can
  # change which service is the default while inheriting the service itself.
  def services
    @services ||= (config_data[repo_key] || {}).merge(config_data[folder_key] || {})
  end

  def commands
    services.reject { |name, _| name == 'default' }
  end

  def run_start(name)
    abort no_services_message if commands.empty?

    name ||= pick if opts[:interactive]
    name ||= services['default'] || (commands.keys.first if commands.size == 1) || pick
    abort 'start: nothing selected' if name.nil?

    command = commands[name]
    abort "start: no service #{name.inspect} here. Available: #{commands.keys.join(', ')}" if command.nil?

    warn_about_dropped_args(name, command)
    launch(command, *ARGV)
  end

  # bash -c, not exec(command, *args): Ruby only uses a shell when exec gets
  # exactly one argument, so passing args would make the ; and && in a command
  # literal argv. bash -c CMD NAME ARGS puts ARGS in $1..$n, which is why args
  # only land where the command says "$@".
  def launch(command, *args)
    puts command.cyan if pretend? || !quiet?
    exec('bash', '-c', command, 'start', *args) unless pretend?
  end

  # Warn but still launch -- the service is what was asked for.
  def warn_about_dropped_args(name, command)
    return if ARGV.empty? || command.match?(/\$[@*1-9]/)

    warn %(start: #{name.inspect} does not use "$@"; ignoring extra args: #{ARGV.join(' ')})
  end

  def no_services_message
    <<~MSG.rstrip
      start: no services recorded for this location. Looked under:
        folder: #{folder_key}
        repo:   #{repo_key || '(no git remote)'}
      Record one with: start new <service> '<command>'
    MSG
  end

  # selecta does its UI on /dev/tty, so both pipe ends are free for the list
  # and the answer.
  def pick
    width = commands.keys.map(&:length).max
    by_line = commands.to_h { |name, command| [format("%-#{width}s  %s", name, command), name] }
    choice = IO.popen(SELECTA, 'r+') do |io|
      io.puts by_line.keys
      io.close_write
      io.read
    end
    $?&.success? ? by_line[choice.to_s.chomp] : nil
  end

  def run_edit
    unless pretend?
      FileUtils.mkdir_p(File.dirname(config_path))
      File.write(config_path, '') unless File.exist?(config_path)
    end
    editor = ENV['EDITOR'].to_s.empty? ? 'vi' : ENV['EDITOR']
    launch("#{editor} #{config_path.shellescape}")
  end

  def run_new
    sub = Optimist.options do
      banner <<~BANNER
        start new - record a service for this location

        Usage:
          start new [--repo|--folder] [--default] <service> '<command>'

        Write "$@" in the command wherever args from `start <service> ...` go.
        Quote the whole command as one argument.

        Options:
      BANNER
      opt :repo, 'Attach to the git remote (every checkout of this repo)', default: false
      opt :folder, 'Attach to this folder only', default: false
      opt :default, 'Make this the default service for the location', default: false
      conflicts :repo, :folder
    end

    name, *rest = ARGV
    Optimist.die 'give a service name and a command' if name.nil? || rest.empty?
    Optimist.die "quote the command as one argument (got #{rest.length})" if rest.length > 1
    Optimist.die "#{name.inspect} is reserved" if RESERVED.include?(name)

    write_entry(new_scope(sub), name, rest.first, sub[:default])
  end

  # Standing at the repo root says "this is a property of the app"; standing in
  # a subdirectory or a plain folder says "this is a property of this folder".
  def new_scope(sub)
    return folder_key if sub[:folder]
    return repo_key || abort('start: --repo needs a git repo with a usable remote here') if sub[:repo]

    Dir.exist?('.git') ? (repo_key || folder_key) : folder_key
  end

  # Insert lines; never YAML.load/dump round-trip -- Psych would delete the
  # user's comments.
  def write_entry(scope, name, command, make_default)
    lines = File.exist?(config_path) ? File.readlines(config_path) : []
    header = lines.index { |line| line.chomp =~ /\A#{Regexp.escape(scope)}:\s*(#.*)?\z/ }

    if header
      # A later duplicate key would win over the one we insert, so drop any
      # existing default: line in this block first.
      lines.reject!.with_index { |line, i| i > header && block?(lines, header, i) && line =~ /\A\s+default:/ } if make_default
      lines[header] = "#{lines[header].chomp}\n"
      lines.insert(header + 1, entry(name, command))
      lines.insert(header + 1, "  default: #{name}\n") if make_default
    else
      lines << "\n" unless lines.empty? || lines.last.end_with?("\n")
      lines << "#{scope}:\n"
      lines << "  default: #{name}\n" if make_default
      lines << entry(name, command)
    end

    if pretend?
      puts lines.join
    else
      FileUtils.mkdir_p(File.dirname(config_path))
      File.write(config_path, lines.join)
      puts "recorded #{name} under #{scope}".green unless quiet?
    end
  end

  # True while line i is still inside the block that starts at header.
  def block?(lines, header, index)
    ((header + 1)..index).all? { |i| lines[i].strip.empty? || lines[i].start_with?(' ', "\t") }
  end

  # Always double-quote: commands routinely contain #, :, and single quotes,
  # all of which are hostile to bare YAML scalars.
  def entry(name, command)
    %(  #{name}: "#{command.gsub(/[\\"]/) { |c| "\\#{c}" }}"\n)
  end
end

Application.new.run if __FILE__ == $PROGRAM_NAME
