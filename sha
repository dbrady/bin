#!/usr/bin/env ruby
# sha - dump a SHA hash of given text/files.
#
# Usage:
#   sha <file> [<file>]
#   echo "foo" | sha


### DO WARNING MESSAGE - WE AIN'T USE THIS NO MORE!
warning = "SHA1 is known to be broken. Use SHA256 or higher."
warning = "\e[1;37;41m#{warning}\e[0m"if $stdout.tty?
$stderr.puts warning

require 'digest/md5'

digest = Digest::SHA1.new
ARGF.each do |line|
  digest << line
end

puts digest.hexdigest
