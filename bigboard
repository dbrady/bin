#!/usr/bin/env ruby
# frozen_string_literal: true

# bigboard - A billboard of huge text on a grid, meant to run full-screen on a
# spare monitor. The board lives in one JSON file on vapor
# (~/.bigboard/board.json); every command reads it over ssh, edits it, and
# writes it back. There is one writer on one machine, so there is no locking.
#
#   bigboard add "Finish RAMRR-444" --fg=white --bg=red --at=0,0
#   bigboard remove --at 0,0
#   bigboard remove "Finish RAMRR-444"
#   bigboard move "Finish RAMRR-444" --to=1,3
#   bigboard rename "Finish RAMRR-444" "Finished RAMRR-444"
#   bigboard swap "Finish RAMRR-444" "Review Party"
#   bigboard edit "Finish RAMRR-444" --bg=green
#   bigboard task:add "Finish RAMRR-444"
#   bigboard task:dev "Finish RAMRR-444"
#   bigboard task:done "Finish RAMRR-444"
#   bigboard task:cancel "Finish RAMRR-444"
#   bigboard serve                 # then open http://localhost:4567
#
# The JSON travels over ssh's stdin/stdout rather than the remote command line,
# so item text needs no shell escaping.
require 'colorize'
require 'json'
require 'optimist'
$LOAD_PATH.unshift(File.expand_path('~/bin/lib'))
require 'dbrady_cli'
String.disable_colorization unless $stdout.tty?

# Reads and writes the board file on vapor.
class RemoteBoard
  HOST = 'vapor'
  REMOTE_DIR = '~/.bigboard'
  REMOTE_FILE = "#{REMOTE_DIR}/board.json".freeze
  EMPTY_BOARD = { 'rows' => 6, 'cols' => 3, 'items' => [] }.freeze

  def self.fetch
    json = IO.popen(['ssh', HOST, "test -f #{REMOTE_FILE} && cat #{REMOTE_FILE}; true"], &:read)
    raise "could not read #{HOST}:#{REMOTE_FILE} (#{describe_exit($?)})" unless $?.success?

    json.strip.empty? ? JSON.parse(JSON.generate(EMPTY_BOARD)) : JSON.parse(json)
  end

  def self.store(board)
    IO.popen(['ssh', HOST, "mkdir -p #{REMOTE_DIR} && cat > #{REMOTE_FILE}"], 'w') do |io|
      io.write(JSON.pretty_generate(board))
    end
    raise "could not write #{HOST}:#{REMOTE_FILE} (#{describe_exit($?)})" unless $?.success?
  end

  def self.describe_exit(status)
    status.exitstatus == 255 ? "could not connect to #{HOST}" : "exit #{status.exitstatus}"
  end
end

# Serves the board page and a cached copy of the board JSON. The cache keeps
# an open browser tab from running ssh on every poll; with no tab open, the
# server makes no ssh calls at all.
class BoardServer
  CACHE_SECONDS = 10

  def initialize(port)
    @port = port
    @lock = Mutex.new
    @board = nil
    @fetched_at = Time.at(0)
    @error = nil
  end

  def start
    require 'webrick'
    server = WEBrick::HTTPServer.new(Port: @port, BindAddress: '127.0.0.1', AccessLog: [])
    server.mount_proc('/board.json') { |_req, res| respond_json(res) }
    server.mount_proc('/') { |_req, res| respond_page(res) }
    trap('INT') { server.shutdown }
    puts "bigboard: serving http://localhost:#{@port}".cyan
    server.start
  end

  private

  def respond_json(res)
    res['Content-Type'] = 'application/json'
    res.body = JSON.generate(current_board)
  end

  def respond_page(res)
    res['Content-Type'] = 'text/html; charset=utf-8'
    res.body = PAGE
  end

  # On a failed fetch, keep serving the last good board and report the error
  # alongside it, so a vapor hiccup doesn't blank the monitor.
  def current_board
    @lock.synchronize do
      if Time.now - @fetched_at > CACHE_SECONDS
        begin
          @board = RemoteBoard.fetch
          @error = nil
        rescue StandardError => e
          @error = e.message
        end
        @fetched_at = Time.now
      end
      (@board || RemoteBoard::EMPTY_BOARD).merge('error' => @error)
    end
  end

  PAGE = <<~HTML
    <!doctype html>
    <html>
    <head>
      <meta charset="utf-8">
      <title>bigboard</title>
      <style>
        html, body { margin: 0; height: 100%; background: #111; color: #eee;
                     font-family: -apple-system, Helvetica, Arial, sans-serif; }
        #board { display: grid; gap: 8px; padding: 8px; height: 100vh; box-sizing: border-box; }
        .cell { position: relative; display: flex; align-items: center; justify-content: center;
                text-align: center; border-radius: 12px; background: #1b1b1b; overflow: hidden;
                font-weight: 800; line-height: 1.05; padding: 0 2vw;
                container-type: size; isolation: isolate; }
        .at { position: absolute; inset: 0; z-index: -1; display: flex; align-items: center;
              justify-content: center; font-size: min(70cqh, 35cqw); opacity: 0.08;
              pointer-events: none; }
        #error { position: fixed; bottom: 6px; right: 10px; font-size: 14px; color: #f66; }
      </style>
    </head>
    <body>
      <div id="board"></div>
      <div id="error"></div>
      <script>
        // Binary-searches for the largest font size at which the cell's text
        // neither overflows its height nor has to break inside a word.
        function fitText(cell) {
          let lo = 8, hi = cell.clientHeight;
          while (hi - lo > 1) {
            const mid = (lo + hi) >> 1;
            cell.style.fontSize = mid + 'px';
            const fits = cell.scrollHeight <= cell.clientHeight &&
                         cell.scrollWidth <= cell.clientWidth;
            if (fits) lo = mid; else hi = mid;
          }
          cell.style.fontSize = lo + 'px';
        }

        function fitAllText() {
          document.querySelectorAll('.cell.filled').forEach(fitText);
        }

        async function refresh() {
          let board;
          try {
            board = await (await fetch('/board.json')).json();
          } catch (e) {
            document.getElementById('error').textContent = 'bigboard server unreachable';
            return;
          }
          document.getElementById('error').textContent = board.error || '';
          const grid = document.getElementById('board');
          grid.style.gridTemplateColumns = `repeat(${board.cols}, 1fr)`;
          grid.style.gridTemplateRows = `repeat(${board.rows}, 1fr)`;
          grid.replaceChildren();
          for (let row = 0; row < board.rows; row++) {
            for (let col = 0; col < board.cols; col++) {
              const item = board.items.find(i => i.row === row && i.col === col);
              const cell = document.createElement('div');
              cell.className = 'cell';
              const label = document.createElement('span');
              label.className = 'at';
              label.textContent = `${col},${row}`;
              cell.append(label);
              if (item) {
                cell.classList.add('filled');
                cell.append(document.createTextNode(item.text));
                if (item.fg) cell.style.color = item.fg;
                if (item.bg) cell.style.background = item.bg;
              }
              grid.append(cell);
            }
          }
          fitAllText();
        }
        refresh();
        setInterval(refresh, 10000);
        window.addEventListener('resize', fitAllText);
      </script>
    </body>
    </html>
  HTML
end

# CLI Application
class Application
  include DbradyCli

  SUBCOMMANDS = %w[add remove rm move rename swap edit serve task:add task:dev task:done task:cancel].freeze

  def parse_options
    @opts = Optimist.options do
      banner <<~BANNER
        bigboard - Huge text on a grid, stored in #{RemoteBoard::HOST}:#{RemoteBoard::REMOTE_FILE}

        Usage:
          bigboard [global options] <subcommand> [subcommand options]

        Subcommands:
          add          Put text on the board (first open slot, --last, or --at col,row)
          remove       Take text off the board, by its text or by --at col,row (alias: rm)
          move         Move an item to an empty slot, by its text or by --from col,row
          rename       Change an item's text, keeping its slot and colors
          swap         Exchange the slots of two items, each by text or by col,row
          edit         Change any of an item's text, slot, fg, bg; the rest stays as it was
          serve        Serve the board at http://localhost:4567
          task:add     Add, with --bg=darkred unless given
          task:dev     Edit, with --bg=darkblue unless given
          task:done    Edit, with --fg=gray --bg=darkgreen --last unless given
          task:cancel  Edit, with --fg=gray --bg=dimgray --last unless given

        Global options (must come BEFORE the subcommand):
      BANNER
      opt :debug,   'Print extra debug info', short: :d, default: false
      opt :pretend, 'Print the new board but do not write it', short: :p, default: false
      opt :quiet,   'Run with minimal output', short: :q, default: false
      opt :verbose, 'Run with verbose output (overrides --quiet)', short: :v, default: false
      stop_on SUBCOMMANDS
    end
    opts[:quiet] = !opts[:verbose] if opts[:verbose_given]
    dump_opts if debug?

    @subcommand = ARGV.shift
    Optimist.educate if @subcommand.nil?
  end

  def run
    parse_options
    case @subcommand
    when 'add'          then run_add
    when 'remove', 'rm' then run_remove
    when 'move'         then run_move
    when 'rename'       then run_rename
    when 'swap'         then run_swap
    when 'edit'         then run_edit
    when 'serve'        then run_serve
    when 'task:add'     then run_add(bg: 'darkred')
    when 'task:dev'     then run_edit(bg: 'darkblue')
    when 'task:done'    then run_edit(fg: 'gray', bg: 'darkgreen', last: true)
    when 'task:cancel'  then run_edit(fg: 'gray', bg: 'dimgray', last: true)
    else
      abort "bigboard: unknown subcommand '#{@subcommand}'. Run 'bigboard --help' for usage.".red
    end
  rescue RuntimeError => e
    abort "bigboard: #{e.message}".red
  end

  def run_add(defaults = {})
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard add "text" [--fg COLOR] [--bg COLOR] [--at COL,ROW | --last]

        Without --at, the text goes in the first open slot, filling each row
        left to right. With --last, it goes in the last open slot, filling from
        the bottom right. With --at, it replaces whatever is in that slot.
        Colors are any CSS color: red, #ff0, rgb(0 0 0).

        Options:
      BANNER
      opt :fg,    'Text (foreground) color', type: :string, alt: :color
      opt :bg,    'Background color', type: :string
      opt :at,    'Slot as COL,ROW, zero-based (0,0 is top left)', type: :string
      opt :last,  'Use the last open slot instead of the first', default: false
    end
    apply_defaults(subopts, defaults)
    text = ARGV.join(' ')
    abort 'bigboard: add needs some text'.red if text.strip.empty?

    board = RemoteBoard.fetch
    row, col = if subopts[:at] then parse_at(subopts[:at], board)
               elsif subopts[:last] then last_open_slot(board)
               else first_open_slot(board)
               end
    board['items'].reject! { |item| item['row'] == row && item['col'] == col }
    board['items'] << { 'row' => row, 'col' => col, 'text' => text,
                        'fg' => subopts[:fg], 'bg' => subopts[:bg] }.compact
    save(board, "added at #{col},#{row}: #{text}")
  end

  def run_remove
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard remove "text"
               bigboard remove --at COL,ROW

        Removing by text takes off every item whose text matches exactly.

        Options:
      BANNER
      opt :at, 'Slot as COL,ROW, zero-based (0,0 is top left)', type: :string
    end
    text = ARGV.join(' ')
    abort 'bigboard: remove needs some text or --at COL,ROW'.red if text.strip.empty? && !subopts[:at]

    board = RemoteBoard.fetch
    if subopts[:at]
      row, col = parse_at(subopts[:at], board)
      removed = board['items'].reject! { |item| item['row'] == row && item['col'] == col }
      abort "bigboard: nothing at #{col},#{row}".red unless removed
      save(board, "removed #{col},#{row}")
    else
      removed = board['items'].reject! { |item| item['text'] == text }
      abort "bigboard: no item reads exactly \"#{text}\"".red unless removed
      save(board, "removed: #{text}")
    end
  end

  def run_move
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard move "text" --to COL,ROW
               bigboard move --from COL,ROW --to COL,ROW

        Moves one item to an empty slot. Its colors go with it. To move an
        item onto another item, use swap.

        Options:
      BANNER
      opt :from, 'Slot of the item to move, as COL,ROW', type: :string
      opt :to,   'Slot to move it to, as COL,ROW', type: :string, required: true
    end
    text = ARGV.join(' ')
    abort 'bigboard: move needs some text or --from COL,ROW'.red if text.strip.empty? && !subopts[:from]

    board = RemoteBoard.fetch
    item = find_item(board, text, subopts[:from])
    row, col = parse_at(subopts[:to], board)
    place(board, item, row, col)
    save(board, "moved to #{col},#{row}: #{item['text']}")
  end

  def run_rename
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard rename "old text" "new text"
               bigboard rename --at COL,ROW "new text"

        Changes an item's text. Its slot and colors stay as they were.

        Options:
      BANNER
      opt :at, 'Slot of the item to rename, as COL,ROW', type: :string
    end
    new_text = ARGV.pop.to_s
    old_text = ARGV.join(' ')
    abort 'bigboard: rename needs the new text'.red if new_text.strip.empty?
    abort 'bigboard: rename needs the old text or --at COL,ROW'.red if old_text.strip.empty? && !subopts[:at]

    board = RemoteBoard.fetch
    item = find_item(board, old_text, subopts[:at])
    item['text'] = new_text
    save(board, "renamed #{item['col']},#{item['row']}: #{new_text}")
  end

  def run_swap
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard swap "text" "other text"
               bigboard swap "text" --to COL,ROW
               bigboard swap --from COL,ROW --to COL,ROW
               bigboard swap --from COL,ROW "text"

        Exchanges the slots of two items. Each side is a text or a slot, in any
        order. Colors go with their items. If one slot is empty, the other
        item just moves there.

        Options:
      BANNER
      opt :from, 'Slot of one item, as COL,ROW', type: :string
      opt :to,   'Slot of the other item, as COL,ROW', type: :string
    end
    slots = [subopts[:from], subopts[:to]].compact
    unless ARGV.size + slots.size == 2
      abort 'bigboard: swap needs exactly two sides, each a "text" or a --from/--to COL,ROW'.red
    end

    board = RemoteBoard.fetch
    sides = ARGV.map { |text| find_item(board, text, nil) }
    sides += slots.map { |at| item_or_empty_slot(board, at) }
    one, other = sides
    one['row'], one['col'], other['row'], other['col'] = other['row'], other['col'], one['row'], one['col']
    moved = sides.select { |side| side['text'] }
    if moved.size == 1
      save(board, "moved to #{moved[0]['col']},#{moved[0]['row']}: #{moved[0]['text']}")
    else
      save(board, "swapped: #{one['text']} is now at #{one['col']},#{one['row']}, " \
                  "#{other['text']} at #{other['col']},#{other['row']}")
    end
  end

  def run_edit(defaults = {})
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard edit "text" [changes]
               bigboard edit --at COL,ROW [changes]
               where changes are any of: "new text" --to COL,ROW --last --fg COLOR --bg COLOR

        Changes any mix of an item's text, slot, and colors in one go. Anything
        not mentioned stays as it was. The first text picks the item when some
        item reads exactly that; otherwise --at picks the item and the text is
        its new text. When the item is picked by its text, --at and --to both
        mean the new slot. --last moves the item to the last open slot, counting
        its own slot as open; a new slot from --at or --to wins over --last. A
        color of none clears that color so the page shows its default.

          bigboard edit "Review Party" --at 1,3
          bigboard edit --at=0,0 --to=1,3
          bigboard edit "Review Party" "Reviewed It"
          bigboard edit --at=0,0 "Reviewed It"
          bigboard edit "Review Party" --bg=cyan
          bigboard edit "Review Party" --last

        Options:
      BANNER
      opt :at, 'Slot of the item to edit, as COL,ROW; with a text, the new slot', type: :string
      opt :to, 'New slot, as COL,ROW', type: :string
      opt :fg, 'New text (foreground) color, or none', type: :string, alt: :color
      opt :bg, 'New background color, or none', type: :string
      opt :last, 'Move to the last open slot', default: false
    end
    apply_defaults(subopts, defaults)
    abort 'bigboard: edit needs some text or --at COL,ROW'.red if ARGV.empty? && !subopts[:at]

    board = RemoteBoard.fetch
    if ARGV.any? && (subopts[:at].nil? || board['items'].any? { |item| item['text'] == ARGV[0] })
      item = find_item(board, ARGV.shift, nil)
      new_slot = subopts[:to] || subopts[:at]
    else
      item = find_item(board, nil, subopts[:at])
      new_slot = subopts[:to]
    end
    new_slot = parse_at(new_slot, board) if new_slot
    new_slot ||= last_open_slot(board, except: item) if subopts[:last]
    new_text = ARGV.join(' ')
    changes = [new_text.strip.empty? ? nil : new_text, new_slot, subopts[:fg], subopts[:bg]].compact
    abort 'bigboard: edit needs something to change'.red if changes.empty?

    item['text'] = new_text unless new_text.strip.empty?
    place(board, item, *new_slot) if new_slot
    %w[fg bg].each do |color|
      next unless subopts[color.to_sym]

      subopts[color.to_sym] == 'none' ? item.delete(color) : item[color] = subopts[color.to_sym]
    end
    save(board, "edited #{item['col']},#{item['row']}: #{item['text']}")
  end

  def run_serve
    subopts = Optimist.options do
      banner <<~BANNER
        Usage: bigboard serve [--port PORT]

        Serves the board page on localhost. The page refreshes itself every
        10 seconds. The server reads from vapor at most once every
        #{BoardServer::CACHE_SECONDS} seconds, and only while a page is open.

        Options:
      BANNER
      opt :port, 'Port to listen on', default: 4567
    end
    BoardServer.new(subopts[:port]).start
  end

  private

  def parse_at(at, board)
    col, row = at.split(',', 2).map { |n| Integer(n, exception: false) }
    abort "bigboard: a slot is COL,ROW like 1,0 (got #{at.inspect})".red if row.nil? || col.nil?
    unless row.between?(0, board['rows'] - 1) && col.between?(0, board['cols'] - 1)
      abort "bigboard: #{at} is off the board (cols 0-#{board['cols'] - 1}, rows 0-#{board['rows'] - 1})".red
    end
    [row, col]
  end

  # Options the user typed win over the defaults a task: subcommand supplies.
  def apply_defaults(subopts, defaults)
    defaults.each { |key, value| subopts[key] = value unless subopts[:"#{key}_given"] }
  end

  def first_open_slot(board)
    open_slots(board).first || abort('bigboard: the board is full. Remove something or use --at to replace it.'.red)
  end

  def last_open_slot(board, except: nil)
    open_slots(board, except: except).last ||
      abort('bigboard: the board is full. Remove something or use --at to replace it.'.red)
  end

  # Slots as [row, col], in reading order. The except item's slot counts as open.
  def open_slots(board, except: nil)
    taken = board['items'].reject { |item| item.equal?(except) }.map { |item| [item['row'], item['col']] }
    (0...board['rows']).to_a.product((0...board['cols']).to_a).reject { |pair| taken.include?(pair) }
  end

  def item_at(board, row, col)
    board['items'].find { |item| item['row'] == row && item['col'] == col }
  end

  # A slot given as COL,ROW wins over text, so a blank text with --at works.
  def find_item(board, text, at)
    if at
      row, col = parse_at(at, board)
      item = item_at(board, row, col)
      abort "bigboard: nothing at #{col},#{row}".red unless item
      return item
    end

    matches = board['items'].select { |item| item['text'] == text }
    abort "bigboard: no item reads exactly \"#{text}\"".red if matches.empty?
    if matches.size > 1
      slots = matches.map { |item| "#{item['col']},#{item['row']}" }.join(' and ')
      abort "bigboard: #{matches.size} items read \"#{text}\", at #{slots}. Pick one by its slot instead.".red
    end
    matches[0]
  end

  def item_or_empty_slot(board, at)
    row, col = parse_at(at, board)
    item_at(board, row, col) || { 'row' => row, 'col' => col }
  end

  def place(board, item, row, col)
    occupant = item_at(board, row, col)
    if occupant && !occupant.equal?(item)
      abort "bigboard: #{col},#{row} already has \"#{occupant['text']}\". Use swap to exchange them.".red
    end
    item['row'] = row
    item['col'] = col
  end

  def save(board, message)
    if pretend?
      puts JSON.pretty_generate(board)
      return
    end
    RemoteBoard.store(board)
    puts message.green unless quiet?
  end
end

Application.new.run if __FILE__ == $PROGRAM_NAME
